# ── Editor ───────────────────────────────────────────────────────────────────
# Password of the editorial area (#/editor). Required in production: without it
# the server is read-only. In development (no token) the editor is open.
EDITOR_TOKEN=change-me

# ── GitHub (optional): the repository that holds the XML files ───────────────
# GITHUB_REPO alone is enough to READ a public repository (periodic pull).
# GITHUB_TOKEN (fine-grained PAT, "Contents: Read and write", only on that repo)
# is needed to WRITE: every save in the editor becomes a commit.
GITHUB_REPO=LARESproject/LARES
GITHUB_TOKEN=
# GITHUB_BRANCH=master   # default: the repository's default branch
GITHUB_DATA_PATH=webapps/ROOT/content/xml/epidoc
GITHUB_PULL_INTERVAL_MIN=5

# Local folder of the XML files (default: public/data)
# DATA_DIR=public/data

PORT=3000

# Local runtime files (defaults): previous file versions and sync bookkeeping
# BACKUP_DIR=.lares-backups
# STATE_FILE=.lares-state.json
